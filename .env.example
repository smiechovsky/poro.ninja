# PostgreSQL connection
DB_HOST=db
DB_PORT=5432
DB_DATABASE=poro_ninja
DB_USERNAME=user
DB_PASSWORD=pass

# Riot API key
API_KEY=your-api-key

# Champion data version
DDRAGON_Version=15.14.1

# Express port
PORT=8000

#DEBUGER Configuration
# Logging level for application debugging
# 0 = No logs (silent mode)
# 1 = Basic logs (start/end of processes, summary)
# 2 = Detailed logs (step-by-step process details)
# Default: 0 (if not set)
LOGS_LEVEL=1

# Accounts Finder Configuration
# Interval between account finding loops in seconds (default: 3600 = 1 hour)
ACCOUNTS_FINDER_INTERVAL_SECONDS=3600

# Number of matches to check per account (default: 100)
MATCHES_PER_ACCOUNT=100

# Global API budget (2-minute window)
BUDGET_LIMIT_TOTAL=100           # dla Twojego klucza: 100 req / 2 min
# (opcjonalnie, jeśli chcesz inną długość okna)
BUDGET_WINDOW_MS=120000          # default 120000 (2 min), możesz pominąć

VIP_SYNC_INTERVAL_HOURS=2
VIP_MATCHES_PER_ACCOUNT=100